# NIDDE — ENVIRONMENT VARIABLES EXAMPLE
# DO NOT PUT REAL SECRETS HERE. This file is safe to commit.
# Copy to.env.local and fill with real values.

# 1. Server
PORT=3000
NODE_ENV=development
API_BASE_URL=http://localhost:3000

# 2. Database
DATABASE_URL=postgresql://user:password@localhost:5432/nidde_dev
DB_POOL_SIZE=10

# 3. Authentication
JWT_SECRET=your_jwt_secret_here
JWT_EXPIRES_IN=7d

# 4. Payment Integration - AG-08
PAYMENT_PROVIDER_API_KEY=your_payment_key_here
PAYMENT_WEBHOOK_SECRET=your_webhook_secret_here

# 5. KYC Integration
KYC_PROVIDER_API_KEY=your_kyc_key_here

# 6. External Providers
STORAGE_BUCKET_NAME=nidde-dev-bucket
STORAGE_ACCESS_KEY=your_storage_key_here

# 7. Android
ANDROID_API_URL=http://10.0.2.2:3000
