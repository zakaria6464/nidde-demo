# ============================================================
# NIDDE — ENVIRONMENT CONFIGURATION TEMPLATE
# ============================================================
# IMPORTANT:
# This file contains placeholders only.
# NEVER place real production secrets in this file.
# Copy the required variables into the appropriate local/secret
# environment configuration outside Git.
#
# Architecture baseline: AG-01 → AG-13
# Security authority: AG-07
# External integrations: AG-08
# CI/CD: AG-11
# Production: AG-12
# Release: AG-13
# ============================================================


# ------------------------------------------------------------
# APPLICATION
# ------------------------------------------------------------

APP_NAME=NIDDE
APP_ENV=development
APP_VERSION=0.1.0

# Example values only:
APP_HOST=127.0.0.1
APP_PORT=3000

# Allowed examples:
# development
# staging
# production
APP_ENVIRONMENT=development


# ------------------------------------------------------------
# DATABASE
# ------------------------------------------------------------

DATABASE_HOST=localhost
DATABASE_PORT=5432
DATABASE_NAME=nidde
DATABASE_USER=example_user

# NEVER place a real password here.
DATABASE_PASSWORD=CHANGE_ME

# Example only.
DATABASE_SSL_MODE=require


# ------------------------------------------------------------
# API
# ------------------------------------------------------------

API_VERSION=v1
API_BASE_PATH=/api/v1

# Example only.
API_PUBLIC_URL=http://localhost:3000


# ------------------------------------------------------------
# AUTHENTICATION
# ------------------------------------------------------------

# Secret placeholders only.
AUTH_SESSION_SECRET=CHANGE_ME
AUTH_TOKEN_SECRET=CHANGE_ME
AUTH_REFRESH_SECRET=CHANGE_ME

# Session configuration examples.
AUTH_ACCESS_TOKEN_TTL=15m
AUTH_REFRESH_TOKEN_TTL=30d


# ------------------------------------------------------------
# CORS
# ------------------------------------------------------------

CORS_ALLOWED_ORIGINS=http://localhost:3000


# ------------------------------------------------------------
# RATE LIMITING
# ------------------------------------------------------------

RATE_LIMIT_ENABLED=true
RATE_LIMIT_WINDOW_SECONDS=60
RATE_LIMIT_MAX_REQUESTS=100


# ------------------------------------------------------------
# LOGGING
# ------------------------------------------------------------

LOG_LEVEL=info
LOG_FORMAT=json

# Never enable sensitive-data logging in production.
LOG_SENSITIVE_DATA=false


# ------------------------------------------------------------
# STORAGE
# ------------------------------------------------------------

STORAGE_PROVIDER=local

# Example only.
STORAGE_BUCKET=nidde-example

# Provider credentials must be supplied through a secure
# environment/secret-management mechanism.
STORAGE_ACCESS_KEY=CHANGE_ME
STORAGE_SECRET_KEY=CHANGE_ME


# ------------------------------------------------------------
# PAYMENT — AG-08
# ------------------------------------------------------------

PAYMENT_PROVIDER=CHANGE_ME

# Public identifier may be configured separately if required.
PAYMENT_PUBLIC_KEY=CHANGE_ME

# NEVER commit real payment secrets.
PAYMENT_SECRET_KEY=CHANGE_ME

# Webhook secret must remain protected.
PAYMENT_WEBHOOK_SECRET=CHANGE_ME


# ------------------------------------------------------------
# KYC — AG-08
# ------------------------------------------------------------

KYC_PROVIDER=CHANGE_ME

KYC_API_URL=CHANGE_ME

# NEVER commit real KYC provider credentials.
KYC_API_KEY=CHANGE_ME
KYC_API_SECRET=CHANGE_ME


# ------------------------------------------------------------
# MAPS / LOCATION — AG-08
# ------------------------------------------------------------

MAPS_PROVIDER=CHANGE_ME

# Public client configuration may be supplied separately
# where the selected provider permits it.
MAPS_PUBLIC_KEY=CHANGE_ME

# Provider secret keys must never be embedded in Android.
MAPS_SERVER_KEY=CHANGE_ME


# ------------------------------------------------------------
# NOTIFICATIONS — AG-08
# ------------------------------------------------------------

NOTIFICATION_PROVIDER=CHANGE_ME

NOTIFICATION_API_URL=CHANGE_ME

NOTIFICATION_API_KEY=CHANGE_ME
NOTIFICATION_API_SECRET=CHANGE_ME


# ------------------------------------------------------------
# EMAIL / COMMUNICATION
# ------------------------------------------------------------

EMAIL_PROVIDER=CHANGE_ME
EMAIL_API_URL=CHANGE_ME
EMAIL_API_KEY=CHANGE_ME


# ------------------------------------------------------------
# PUSH NOTIFICATIONS
# ------------------------------------------------------------

PUSH_PROVIDER=CHANGE_ME
PUSH_PROJECT_ID=CHANGE_ME

# Sensitive credentials must remain outside Git.
PUSH_PRIVATE_KEY=CHANGE_ME
PUSH_CLIENT_EMAIL=CHANGE_ME


# ------------------------------------------------------------
# OBSERVABILITY
# ------------------------------------------------------------

OBSERVABILITY_ENABLED=true

# Example only.
OBSERVABILITY_ENDPOINT=CHANGE_ME

# Sensitive observability credentials must not be committed.
OBSERVABILITY_API_KEY=CHANGE_ME


# ------------------------------------------------------------
# SECURITY
# ------------------------------------------------------------

SECURITY_HEADERS_ENABLED=true
SECURE_TRANSPORT_REQUIRED=false

# Development placeholder only.
ENCRYPTION_KEY=CHANGE_ME


# ------------------------------------------------------------
# WEBHOOKS
# ------------------------------------------------------------

WEBHOOK_BASE_URL=http://localhost:3000/api/v1/webhooks

# Never commit real webhook secrets.
WEBHOOK_SIGNING_SECRET=CHANGE_ME


# ------------------------------------------------------------
# BACKGROUND JOBS
# ------------------------------------------------------------

JOBS_ENABLED=true

# Example only.
JOBS_CONCURRENCY=5


# ------------------------------------------------------------
# CACHE
# ------------------------------------------------------------

CACHE_ENABLED=true
CACHE_HOST=localhost
CACHE_PORT=6379

# Never commit a real cache password.
CACHE_PASSWORD=CHANGE_ME


# ------------------------------------------------------------
# ANDROID / CLIENT CONFIGURATION
# ------------------------------------------------------------

# Only non-sensitive public configuration may be exposed
# to the Android application.

ANDROID_API_BASE_URL=http://localhost:3000/api/v1

ANDROID_APP_ENV=development


# ------------------------------------------------------------
# ADMIN CONFIGURATION
# ------------------------------------------------------------

# Administrative authority is always server-side.
# These values must NEVER be used as authorization flags.

ADMIN_API_BASE_URL=http://localhost:3000/api/v1


# ------------------------------------------------------------
# DEVELOPMENT / TESTING
# ------------------------------------------------------------

NODE_ENV=development
TEST_DATABASE_NAME=nidde_test

# Tests must use dedicated non-production credentials.
TEST_EXTERNAL_INTEGRATIONS=false
TEST_REAL_PAYMENTS=false
TEST_REAL_KYC=false


# ------------------------------------------------------------
# CI/CD — AG-11
# ------------------------------------------------------------

CI=false

# CI/CD secrets must be configured through the CI provider's
# protected secret mechanism, not committed here.


# ------------------------------------------------------------
# PRODUCTION
# ------------------------------------------------------------

# Production configuration is managed outside this file.
#
# DO NOT add:
# - production passwords
# - production API keys
# - production database URLs containing credentials
# - private keys
# - payment secrets
# - webhook secrets
# - provider secrets
#
# Production configuration is governed by AG-12.


# ------------------------------------------------------------
# RELEASE
# ------------------------------------------------------------

RELEASE_CHANNEL=development

# Release configuration is governed by AG-13.


# ============================================================
# SECURITY RULE
# ============================================================
#
# This file is SAFE only while it contains placeholders.
#
# Never replace CHANGE_ME with real credentials and commit the
# result to Git.
#
# Real secrets must be provided through the approved secret
# management mechanism for the target environment.
#
# ============================================================
